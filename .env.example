# Port the server listens on. Railway sets this automatically in production.
PORT=3000

# Host to bind to. Leave as-is for local dev and for Railway.
HOST=0.0.0.0

# development | production
NODE_ENV=development

# Optional: attach a Railway Postgres plugin (or any Postgres instance) to
# persist completed-game history. Domirush runs perfectly well without it —
# all real-time gameplay lives in memory and never depends on this.
# DATABASE_URL=postgresql://user:password@host:5432/domirush
